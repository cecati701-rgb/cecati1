<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Formulario Reinscripción - CECATI</title>

    <link rel="stylesheet" href="css/estilos.css">
</head>
<body>

<div class="contenedor">

    <header class="header">
        <img src="img/logo-sep.png" alt="Logo SEP" class="logo">

        <div class="titulos">
          <h2>SUBSECRETARIA DE EDUCACIÓN MEDIA SUPERIOR</h2>
          <h2>DIRECCION GENERAL DE CENTRO DE FORMACIÓN PARA EL TRABAJO</h2>
          <br>
            <h1>Solicitud de Inscripción</h1>
            <h2>CECATI</h2>
            <p>Sistema Digital</p>
        </div>

        <img src="img/logo-cecati.png" alt="Logo CECATI" class="logo">
    </header>


    <form id="formulario1">

        <section class="seccion-formulario">
            <h3>Datos Generales</h3>

            <div class="grid-2">
                <div>
                    <label>Fecha de inscripción</label>
                    <input type="date" id="fechaInscripcion">
                </div>

                <div>
                    <label>Número de solicitud</label>
                    <input type="text" id="numeroSolicitud">
                </div>
            </div>
        </section>


        <section class="seccion-formulario">
            <h3>Datos Personales</h3>

            <div class="grid-3">

                <div>
                    <label>Primer apellido *</label>
                    <input type="text" id="apellido1">
                </div>

                <div>
                    <label>Segundo apellido *</label>
                    <input type="text" id="apellido2">
                </div>

                <div>
                    <label>Nombre(s) *</label>
                    <input type="text" id="nombre">
                </div>

                <div>
                    <label>CURP *</label>
                    <input type="text" id="curp">
                </div>

                <div>
                    <label>RFC</label>
                    <input type="text" id="rfc">
                </div>

                <div>
                    <label>Edad *</label>
                    <input type="number" id="edad">
                </div>

                <div>
                    <label>Teléfono *</label>
                    <input type="number" id="telefono">
                </div>

                <div>
                    <label>Correo *</label>
                    <input type="email" id="correo">
                </div>

                <div>
                    <label>Fecha nacimiento</label>
                    <input type="date" id="fechaNacimiento">
                </div>

            </div>

            <div class="radio-group">
                <label>Sexo:</label>

                <label>
                    <input type="radio" name="sexo" value="Masculino">
                    Masculino
                </label>

                <label>
                    <input type="radio" name="sexo" value="Femenino">
                    Femenino
                </label>
            </div>

        </section>


        <section class="seccion-formulario">
            <h3>DATOS GENERALES</h3>

            <div class="grid-2">

                <div>
                    <label>Especialidad *</label>
                    <input type="text" id="especialidad">
                </div>

                <div>
                    <label>Clave Curso</label>
                    <input type="text" id="claveCurso">
                </div>

                <div>
                    <label>Nombre del Curso *</label>
                    <input type="text" id="nombreCurso">
                </div>

                <div>
                    <label>Horario</label>
                    <input type="text" id="horario">
                </div>

            </div>
        </section>


        <section class="seccion-formulario">
            <h3>Documentación Entregada</h3>

            <div class="checkbox-group">
                <label><input type="checkbox" id="acta"> Acta de nacimiento</label>
                <label><input type="checkbox" id="curpDoc"> CURP</label>
                <label><input type="checkbox" id="ine"> INE</label>
                <label><input type="checkbox" id="domicilio"> Comprobante domicilio</label>
            </div>
        </section>


        <div class="contenedor-boton">
            <button type="button" id="btnSiguiente">Siguiente</button>
        </div>

    </form>

</div>

<script src="js/validaciones.js"></script>
<script src="js/storage.js"></script>
<script src="js/app.js"></script>

</body>
</html>